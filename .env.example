# Placeholder-only example. Do not replace values in this file with live
# secrets. Store real values in approved secret stores or local-only env files.

# Database
DATABASE_URL=postgresql://phynd:phynd@localhost:5432/phynd_crm

# Redis
REDIS_URL=redis://localhost:6379

# Auth (Janua OIDC)
AUTH_SECRET=replace-with-local-dev-secret
AUTH_JANUA_ISSUER=https://janua.example.com
AUTH_JANUA_CLIENT_ID=phynd-crm
AUTH_JANUA_CLIENT_SECRET=replace-with-secret-store-value
AUTH_BYPASS=false
DEV_ACCESS_TOKEN=
# Auth.js host handling behind proxies. Do not set AUTH_URL/NEXTAUTH_URL to an
# internal pod hostname in production.
AUTH_TRUST_HOST=true

# Federation - External Service URLs
JANUA_API_URL=https://api.janua.example.com
JANUA_TELEMETRY_API_URL=https://telemetry.janua.example.com
DHANAM_API_URL=https://api.dhanam.example.com
# Also used by CotizaEngagementEmitterService for outbound engagement webhooks to
# POST ${COTIZA_API_URL}/api/v1/webhooks/phyndcrm/engagements
COTIZA_API_URL=https://api.cotiza.example.com
PRAVARA_BASE_URL=https://api.pravara.example.com
SELVA_API_URL=https://api.selva.example.com
FORJ_API_URL=https://api.forj.example.com

# Federation - API Keys
PRAVARA_API_KEY=replace-with-secret-store-value
SELVA_API_KEY=replace-with-secret-store-value
FEDERATION_API_TOKEN=
# Machine principal for service token (default service:selva — distinct from staff OIDC)
FEDERATION_SERVICE_USER_ID=service:selva

# Production dispatch worker
# Optional endpoint overrides. Defaults:
#   PRAVARA_BASE_URL + /api/v1/fabrication/dispatches
#   SELVA_API_URL + /api/v1/projects/dispatches
PRAVARA_DISPATCH_URL=
SELVA_DISPATCH_URL=
PRAVARA_DISPATCH_SECRET=
SELVA_DISPATCH_SECRET=
PRODUCTION_DISPATCH_SCAN_LIMIT=25
PRODUCTION_DISPATCH_TIMEOUT_MS=15000

# Federation - Webhook Secrets
JANUA_WEBHOOK_SECRET=replace-with-secret-store-value
JANUA_TELEMETRY_WEBHOOK_SECRET=replace-with-secret-store-value
DHANAM_WEBHOOK_SECRET=replace-with-secret-store-value
COTIZA_WEBHOOK_SECRET=replace-with-secret-store-value
PRAVARA_WEBHOOK_SECRET=replace-with-secret-store-value
FORJ_WEBHOOK_SECRET=replace-with-secret-store-value
TEZCA_WEBHOOK_SECRET=replace-with-secret-store-value
FORTUNA_WEBHOOK_SECRET=replace-with-secret-store-value
CEQ_WEBHOOK_SECRET=replace-with-secret-store-value
COFORMA_WEBHOOK_SECRET=replace-with-secret-store-value
PHYND_CRM_EVENTS_SECRET=replace-with-secret-store-value
PHYND_ENGAGEMENT_EVENTS_SECRET=replace-with-secret-store-value
PHYND_CAMPAIGN_IMPORT_SECRET=replace-with-secret-store-value
SELVA_WEBHOOK_SECRET=replace-with-secret-store-value
PHYND_CRM_PROBE_TOKEN=

# Outbound engagement emitter → Cotiza.
# Shared secret; paired with Cotiza's PHYNDCRM_INBOUND_SECRET (same value,
# different env-var name on each side per ecosystem convention).
PHYNDCRM_OUTBOUND_SECRET=replace-with-secret-store-value
# HTTP timeout for the Cotiza engagement emitter (ms). Default 10000.
COTIZA_WEBHOOK_TIMEOUT=10000

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
PORTAL_BASE_URL=http://localhost:3000
DEFAULT_TENANT_ID=madfam
# development | staging | production — staging blocks outbound calls to production MADFAM hosts
PHYND_DEPLOYMENT_TIER=development
NODE_ENV=development

# AI Pipeline - LLM routing (AutoSwarm or direct OpenAI)
OPENAI_API_KEY=replace-with-secret-store-value
# Optional: route completions through AutoSwarm Nexus (omit for direct OpenAI)
# OPENAI_BASE_URL=http://nexus-api.autoswarm.svc.cluster.local/v1

# Tezca Oracle - Internal API
INTERNAL_TEZCA_KEY=replace-with-secret-store-value
TEZCA_API_URL=http://tezca:8000
TEZCA_PUBLIC_URL=https://tezca.mx

# Email / unsubscribe
RESEND_API_KEY=
EMAIL_FROM=Tezca <noreply@janua.dev>
EMAIL_ALLOWLIST_DOMAINS=
UNSUBSCRIBE_SECRET=

# Reddit Bot (u/madfam-bot) — OAuth2 credentials
# Create app at https://www.reddit.com/prefs/apps (script type)
REDDIT_CLIENT_ID=replace-with-secret-store-value
REDDIT_CLIENT_SECRET=replace-with-secret-store-value
REDDIT_REFRESH_TOKEN=replace-with-secret-store-value
REDDIT_USERNAME=madfam-bot
REDDIT_PASSWORD=
REDDIT_USER_AGENT=madfam-bot/1.0
REDDIT_TARGET_SUBREDDITS=DerechoMexicano,LegalAdviceMexico,mexico

# ACCA Treasury Hunter
KARAFIEL_API_URL=http://karafiel:8000/api/v1
KARAFIEL_API_KEY=replace-with-secret-store-value
KARAFIEL_WEBHOOK_SECRET=replace-with-secret-store-value
# Production-only: set FEATURE_TREASURY_HUNTER=true after staging Karafiel/Fortuna split verified
FEATURE_TREASURY_HUNTER=false
FEATURE_AI_KANBAN=false

# Observability (Phase 2)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=info
SENTRY_DSN=
WORKER_HEALTH_PORT=3001
