# Database
DATABASE_URL=postgresql://phyne:phyne@localhost:5432/phyne_crm

# Redis
REDIS_URL=redis://localhost:6379

# Auth (Janua OIDC)
AUTH_SECRET=generate-a-secret-with-openssl-rand-base64-32
AUTH_JANUA_ISSUER=https://janua.example.com
AUTH_JANUA_CLIENT_ID=phyne-crm
AUTH_JANUA_CLIENT_SECRET=your-client-secret

# Federation - External Service URLs
JANUA_API_URL=https://api.janua.example.com
DHANAM_API_URL=https://api.dhanam.example.com
# Also used by CotizaEngagementEmitterService for outbound engagement webhooks to
# POST ${COTIZA_API_URL}/api/v1/webhooks/phynecrm/engagements
COTIZA_API_URL=https://api.cotiza.example.com
PRAVARA_BASE_URL=https://api.pravara.example.com
SELVA_API_URL=https://api.selva.example.com
FORJ_API_URL=https://api.forj.example.com

# Federation - API Keys
PRAVARA_API_KEY=your-pravara-api-key
SELVA_API_KEY=your-selva-api-key

# Production dispatch worker
# Optional endpoint overrides. Defaults:
#   PRAVARA_BASE_URL + /api/v1/fabrication/dispatches
#   SELVA_API_URL + /api/v1/projects/dispatches
PRAVARA_DISPATCH_URL=
SELVA_DISPATCH_URL=
PRAVARA_DISPATCH_SECRET=
SELVA_DISPATCH_SECRET=
PRODUCTION_DISPATCH_SCAN_LIMIT=25
PRODUCTION_DISPATCH_TIMEOUT_MS=15000

# Federation - Webhook Secrets
JANUA_WEBHOOK_SECRET=your-janua-webhook-secret
DHANAM_WEBHOOK_SECRET=your-dhanam-webhook-secret
COTIZA_WEBHOOK_SECRET=your-cotiza-webhook-secret
PRAVARA_WEBHOOK_SECRET=your-pravara-webhook-secret
FORJ_WEBHOOK_SECRET=your-forj-webhook-secret
TEZCA_WEBHOOK_SECRET=your-tezca-webhook-secret
FORTUNA_WEBHOOK_SECRET=your-fortuna-webhook-secret

# Outbound engagement emitter → Cotiza.
# Shared secret; paired with Cotiza's PHYNECRM_INBOUND_SECRET (same value,
# different env-var name on each side per ecosystem convention).
PHYNECRM_OUTBOUND_SECRET=your-shared-phynecrm-engagement-secret
# HTTP timeout for the Cotiza engagement emitter (ms). Default 10000.
COTIZA_WEBHOOK_TIMEOUT=10000

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# AI Pipeline - LLM routing (AutoSwarm or direct OpenAI)
OPENAI_API_KEY=sk-your-openai-api-key
# Optional: route completions through AutoSwarm Nexus (omit for direct OpenAI)
# OPENAI_BASE_URL=http://nexus-api.autoswarm.svc.cluster.local/v1
PHYNE_WEBHOOK_SECRET=internal-secret-token

# Tezca Oracle - Internal API
INTERNAL_TEZCA_KEY=tzk_your-internal-api-key
TEZCA_API_URL=http://tezca:8000

# Reddit Bot (u/madfam-bot) — OAuth2 credentials
# Create app at https://www.reddit.com/prefs/apps (script type)
REDDIT_CLIENT_ID=your-reddit-app-client-id
REDDIT_CLIENT_SECRET=your-reddit-app-client-secret
REDDIT_REFRESH_TOKEN=your-long-lived-refresh-token
REDDIT_BOT_USERNAME=madfam-bot

# ACCA Treasury Hunter
KARAFIEL_API_URL=http://karafiel:8000/api/v1
KARAFIEL_API_KEY=your-karafiel-api-key
KARAFIEL_WEBHOOK_SECRET=your-karafiel-webhook-secret

# Observability (Phase 2)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
