{
  "name": "@phynd/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "format": "biome format --write src/"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.52.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.56.0",
    "@opentelemetry/sdk-node": "^0.56.0",
    "@phynd/config": "workspace:*",
    "@phynd/db": "workspace:*",
    "@phynd/federation": "workspace:*",
    "@phynd/logging": "workspace:*",
    "@phynd/services": "workspace:*",
    "@phynd/types": "workspace:*",
    "@sentry/node": "^10.51.0",
    "bullmq": "^5.34.8",
    "drizzle-orm": "^0.39.3",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
