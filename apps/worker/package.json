{
  "name": "@phyne/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "format": "biome format --write src/"
  },
  "dependencies": {
    "bullmq": "^5.34.8",
    "ioredis": "^5.4.2",
    "@phyne/federation": "workspace:*",
    "@phyne/config": "workspace:*",
    "@phyne/db": "workspace:*",
    "@phyne/types": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "@biomejs/biome": "^1.9.4"
  }
}
