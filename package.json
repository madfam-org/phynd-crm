{
  "name": "phynd-crm",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "test:e2e": "turbo test:e2e",
    "db:generate": "turbo db:generate --filter=@phynd/db",
    "db:migrate": "turbo db:migrate --filter=@phynd/db",
    "db:seed": "turbo db:seed --filter=@phynd/db",
    "db:studio": "turbo db:studio --filter=@phynd/db",
    "typecheck": "turbo typecheck",
    "pp5:data-safety": "node scripts/pp5-staging-data-safety.mjs",
    "pp5:probe-batch": "node scripts/pp5-webhook-batch-probe.mjs",
    "pp5:probe-batch-run": "node scripts/pp5-probe-batch-run.mjs",
    "pp5:branch-protection-check": "node scripts/pp5-github-branch-protection.mjs --mode check --required-checks-from-ci",
    "pp5:branch-protection-apply": "node scripts/pp5-github-branch-protection.mjs --mode apply --required-checks-from-ci --confirm",
    "pp5:staging-reset": "node scripts/pp5-staging-reset.mjs",
    "pp5:pilot-ops": "node scripts/pp5-pilot-ops-checklist.mjs",
    "ci:verify-gates": "node scripts/verify-ci-gates.mjs",
    "pp5:stability": "node scripts/pp5-stability-check.mjs",
    "pp5:readiness": "node scripts/pp5-readiness.mjs",
    "verify:prod-auth": "node scripts/verify-prod-auth-urls.mjs",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "db:migrate:tier": "node scripts/run-tier-migrate.mjs",
    "verify:pilot-readiness": "node scripts/verify-pilot-readiness.mjs",
    "verify:pilot-go-live": "node scripts/verify-pilot-go-live.mjs",
    "verify:post-deploy": "node scripts/verify-post-deploy.mjs",
    "verify:janua-oidc": "node scripts/verify-janua-oidc-checklist.mjs",
    "verify:selva-agent": "node scripts/verify-selva-agent-integration.mjs",
    "verify:client-lifecycle-env": "node scripts/verify-client-lifecycle-env.mjs",
    "verify:client-lifecycle": "node scripts/verify-client-lifecycle.mjs --skip-env",
    "test:pp5": "node --test scripts/__tests__/*.test.mjs",
    "clean": "turbo clean",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@vitest/coverage-v8": "^4.1.0",
    "husky": "^9.1.7",
    "shadcn": "^4.11.0",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  }
}
