{
  "name": "@phyne/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./router": "./src/router.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "format": "biome format --write src/"
  },
  "dependencies": {
    "@trpc/server": "^11.0.0-rc.682",
    "@phyne/services": "workspace:*",
    "@phyne/types": "workspace:*",
    "@phyne/db": "workspace:*",
    "@phyne/federation": "workspace:*",
    "@phyne/config": "workspace:*",
    "superjson": "^2.2.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "vitest": "^3.0.5",
    "typescript": "^5.7.3",
    "@biomejs/biome": "^1.9.4"
  }
}
