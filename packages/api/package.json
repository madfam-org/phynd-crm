{
  "name": "@phynd/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./router": "./src/router.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "format": "biome format --write src/"
  },
  "dependencies": {
    "@phynd/config": "workspace:*",
    "@phynd/db": "workspace:*",
    "@phynd/federation": "workspace:*",
    "@phynd/services": "workspace:*",
    "@phynd/types": "workspace:*",
    "@trpc/server": "^11.0.0-rc.682",
    "graphql": "^16.14.0",
    "graphql-yoga": "^5.21.0",
    "superjson": "^2.2.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
