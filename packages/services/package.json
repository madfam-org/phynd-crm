{
  "name": "@phyne/services",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./context": "./src/context.ts",
    "./errors": "./src/errors.ts",
    "./email": "./src/email/email.service.ts",
    "./email/unsubscribe-token": "./src/email/unsubscribe-token.ts",
    "./email/templates/*": "./src/email/templates/*.ts",
    "./payments/payment-reconciliation": "./src/payments/payment-reconciliation.service.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "format": "biome format --write src/"
  },
  "dependencies": {
    "@phyne/config": "workspace:*",
    "@phyne/db": "workspace:*",
    "@phyne/federation": "workspace:*",
    "@phyne/logging": "workspace:*",
    "@phyne/types": "workspace:*",
    "drizzle-orm": "^0.39.3",
    "ioredis": "^5.4.2",
    "openai": "^6.33.0",
    "resend": "^4.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
