{
  "name": "@phyne/services",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./context": "./src/context.ts",
    "./errors": "./src/errors.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "format": "biome format --write src/"
  },
  "dependencies": {
    "@phyne/config": "workspace:*",
    "@phyne/db": "workspace:*",
    "@phyne/federation": "workspace:*",
    "@phyne/types": "workspace:*",
    "drizzle-orm": "^0.39.3",
    "openai": "^6.33.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
