{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalPassThroughEnv": [
    "AUTH_BYPASS",
    "AUTH_JANUA_CLIENT_ID",
    "AUTH_JANUA_CLIENT_SECRET",
    "AUTH_JANUA_ISSUER",
    "AUTH_SECRET",
    "CEQ_WEBHOOK_SECRET",
    "CI",
    "COFORMA_WEBHOOK_SECRET",
    "COTIZA_API_URL",
    "COTIZA_WEBHOOK_SECRET",
    "COTIZA_WEBHOOK_TIMEOUT",
    "DATABASE_URL",
    "DEV_ACCESS_TOKEN",
    "DHANAM_API_URL",
    "DHANAM_WEBHOOK_SECRET",
    "EMAIL_ALLOWLIST_DOMAINS",
    "EMAIL_FROM",
    "FEDERATION_API_TOKEN",
    "FORJ_API_URL",
    "FORJ_WEBHOOK_SECRET",
    "FORTUNA_WEBHOOK_SECRET",
    "INTERNAL_TEZCA_KEY",
    "JANUA_API_URL",
    "JANUA_TELEMETRY_API_URL",
    "JANUA_TELEMETRY_WEBHOOK_SECRET",
    "JANUA_WEBHOOK_SECRET",
    "KARAFIEL_API_KEY",
    "KARAFIEL_API_URL",
    "KARAFIEL_WEBHOOK_SECRET",
    "LOG_LEVEL",
    "NEXTAUTH_URL",
    "NEXT_PUBLIC_APP_URL",
    "NODE_ENV",
    "OPENAI_API_KEY",
    "OPENAI_BASE_URL",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "PHYNECRM_OUTBOUND_SECRET",
    "PHYNE_CRM_EVENTS_SECRET",
    "PHYNE_CRM_PROBE_TOKEN",
    "PHYNE_ENGAGEMENT_EVENTS_SECRET",
    "PORTAL_BASE_URL",
    "PRAVARA_API_KEY",
    "PRAVARA_BASE_URL",
    "PRAVARA_WEBHOOK_SECRET",
    "REDDIT_CLIENT_ID",
    "REDDIT_CLIENT_SECRET",
    "REDDIT_PASSWORD",
    "REDDIT_REFRESH_TOKEN",
    "REDDIT_TARGET_SUBREDDITS",
    "REDDIT_USERNAME",
    "REDDIT_USER_AGENT",
    "REDIS_URL",
    "RESEND_API_KEY",
    "SENTRY_DSN",
    "TEZCA_API_URL",
    "TEZCA_PUBLIC_URL",
    "TEZCA_WEBHOOK_SECRET",
    "UNSUBSCRIBE_SECRET",
    "WORKER_HEALTH_PORT"
  ],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "format": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "test:coverage": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
